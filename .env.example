# CockroachDB Connection String (Serverless or Dedicated)
COCKROACH_CONN_STRING=postgresql://username:password@host:26257/infra_historian?sslmode=verify-full

# AWS Configuration (Optional: for live Claude 3.5 Bedrock reasoning & Cohere embeddings)
USE_MOCK_BEDROCK=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-english-v3

# Orchestrator & API Ports
PORT=4000
GO_AGENT_URL=http://localhost:5005
